# Copy this file to terraform.tfvars (in this directory) and adjust values as
# needed. For an existing/bare-metal cluster instead of plain Docker Desktop,
# use ../existing-cluster/ — a separate root config with its own state.

# Kubernetes context — "docker-desktop" is the default for Docker Desktop
kubeconfig_path = "~/.kube/config"
kube_context    = "docker-desktop"

# Namespaces
keycloak_namespace = "keycloak"
gateway_namespace  = "gateway"

# Hostname — leave unset ("") to derive from `domain` below (Let's Encrypt
# path), or fall back to keycloak.local (self-signed path, default). Must
# match your /etc/hosts entry either way (127.0.0.1  keycloak.local).
# keycloak_hostname = "keycloak.local"

# ── TLS: Let's Encrypt via Cloudflare DNS-01 (optional) ─────────────────────
# Default is the built-in self-signed CA (leave enable_lets_encrypt = false)
# — that's what certs/ca.crt / "Trust the self-signed CA" in the README is
# for. To get publicly-trusted certs instead, this environment installs
# cert-manager itself and provisions Let's Encrypt ClusterIssuers via a
# Cloudflare DNS-01 challenge (works even though your cluster/hostnames
# aren't publicly reachable — DNS-01 only needs Cloudflare API access, not
# inbound HTTP). Requires:
#   1. A domain managed in Cloudflare DNS.
#   2. A Cloudflare API token scoped to Zone:DNS:Edit on that zone
#      (https://dash.cloudflare.com/profile/api-tokens).
#   3. keycloak.<domain> / kibana.<domain> (etc.) resolving somewhere you can
#      reach them — e.g. /etc/hosts pointing at 127.0.0.1, same as the
#      self-signed path. DNS-01 validates via the Cloudflare API, not by
#      requiring the hostname to actually resolve publicly.
#
# enable_lets_encrypt  = true
# domain               = "example.com"          # keycloak.example.com, kibana.example.com, ...
# cloudflare_api_token = "<your scoped API token>"
# acme_email           = "you@example.com"
# cluster_issuer       = "letsencrypt-staging"   # start here, then "letsencrypt-prod"
enable_lets_encrypt  = false
domain               = ""
cloudflare_api_token = ""
acme_email           = ""
cluster_issuer       = "letsencrypt-staging"

# Keycloak initial admin — change these before applying.
# NOTE: only applied on the very first start (before the master realm exists).
# Rotating the password afterwards must be done inside Keycloak.
keycloak_admin_user     = "admin"
keycloak_admin_password = "changeme"

# PostgreSQL credentials — change these for anything beyond local dev
postgres_db_name     = "keycloak"
postgres_db_user     = "keycloak"
postgres_db_password = "changeme"

# Realm import — set enable_realm_import = false to skip provisioning a realm
enable_realm_import        = true
realm_name                 = "demo"
realm_client_id            = "demo-client"
realm_client_redirect_uris = ["*"]

# Elastic Cloud on Kubernetes — set enable_elastic = false to skip
enable_elastic          = true
elastic_namespace       = "elastic-stack"
eck_version             = "3.4.0"
elastic_stack_version   = "9.4.3"
elastic_es_node_count   = 1       # keep at 1 for Docker Desktop
elastic_es_memory       = "2Gi"
elastic_es_storage_size = "5Gi"
elastic_kibana_memory   = "1Gi"

# Expose Kibana through the NGINX gateway (add its hostname to /etc/hosts:
# 127.0.0.1  kibana.local, or 127.0.0.1  kibana.<domain> under Let's Encrypt).
# Set false to use port-forward only. Leave elastic_kibana_hostname unset
# ("") like keycloak_hostname above to derive from domain, or fall back to
# kibana.local.
expose_kibana_via_gateway = true
# elastic_kibana_hostname = "kibana.local"

# kube-state-metrics — set enable_kube_state_metrics = false to skip.
# Feeds the Elastic Agent kubernetes integration's state_* metrics.
enable_kube_state_metrics        = true
kube_state_metrics_namespace     = "kube-system"
kube_state_metrics_chart_version = "5.27.1"
